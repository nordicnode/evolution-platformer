/target/
**/*.rs.bk
*.pdb

# Tool-local metadata for the coding agent, not part of the project
/.freebuff/

# Champion + export artifacts are generated, but the curated starter pack is not.
/champions/*.json
!/champions/README.md
# Trick codex files are written by a run, not authored.
/champions/codex/
/export/

# Fitness-chart CSV exports from `train-cli train --csv`
/out/

# Route-graph caches, written beside the level file they were derived from (`sim`'s
# `route_cache`, named `l1-flat-run.json.routes`). Keyed by the level's content hash and
# regenerated on demand, so they are artifacts rather than sources — and they follow the level
# file around rather than living in one directory, which is why this is a suffix rule and not
# a path. Deliberately not `*.json`: everything that lists levels does it by that extension.
*.routes

# Recorded sweep arms from `train-cli bench` (its default `--out`), which are measurements
# rather than sources: one command regenerates an arm, and the arm names every knob it was
# taken with, so the file is a convenience for a reader rather than the record itself.
/bench/

# Editor / OS noise
.DS_Store
/.idea/
/.vscode/
*.swp

# Local scratch (benchmarks, research notes pulled in by hand)
/scratch/

# Python bytecode from the art generator (tools/gen_tileset.py, tools/art/*.py)
__pycache__/
*.pyc
